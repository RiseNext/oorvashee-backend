# =============================================================================
# Oorvashee Backend — environment variables
# Copy to `.env` and fill values for local dev. Never commit `.env`.
# Production values live in Railway's secret store, NOT in any file.
# =============================================================================

# --- App ---
APP_ENV=local                                       # local | staging | prod
APP_NAME=oorvashee-backend
APP_VERSION=0.1.0
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO                                      # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                                      # true in staging/prod

# --- Server ---
HOST=0.0.0.0
PORT=8000
WORKERS=1                                           # gunicorn workers (prod)

# --- Database ---
#
# Two URLs by design:
#
#   DATABASE_URL          → runtime FastAPI uses asyncpg (async driver).
#                           Query param for TLS: `ssl=require`.
#
#   ALEMBIC_DATABASE_URL  → Alembic migrations use psycopg (sync driver).
#                           Query param for TLS: `sslmode=require`.
#
# Why both? asyncpg and psycopg parse libpq query parameters differently;
# `?ssl=require` is invalid to psycopg, and `?sslmode=require` is invalid
# to asyncpg. Each driver needs its native format.
#
# --- Local dev (docker-compose Postgres, no SSL) ---
# Only DATABASE_URL is required; ALEMBIC_DATABASE_URL can be left blank
# because the fallback (swap +asyncpg for +psycopg) is safe when there
# are no driver-specific query params.
DATABASE_URL=postgresql+asyncpg://oorvashee:oorvashee@localhost:5432/oorvashee
ALEMBIC_DATABASE_URL=
#
# --- Neon production (BOTH URLs required — different SSL param) ---
# DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST-pooler.REGION.aws.neon.tech/DB?ssl=require
# ALEMBIC_DATABASE_URL=postgresql+psycopg://USER:PASS@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
#
# Tip: Neon's dashboard shows the connection string in the *psycopg* shape
# already; copy that into ALEMBIC_DATABASE_URL as-is, then derive
# DATABASE_URL by swapping `postgresql://` → `postgresql+asyncpg://` and
# `sslmode=require` → `ssl=require`.

DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_POOL_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# --- Clerk (auth) ---
CLERK_ISSUER=https://example.clerk.accounts.dev
CLERK_JWKS_URL=https://example.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUDIENCE=                                     # optional; leave blank to skip aud check
CLERK_AUTHORIZED_PARTIES=http://localhost:3000      # comma-separated; checked against `azp`
CLERK_WEBHOOK_SECRET=whsec_replace_me               # Svix signing secret
CLERK_JWKS_CACHE_TTL_SECONDS=600

# --- Razorpay (Cycle 2) ---
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=oorvashee
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me
# Top-level folder. Use 'local' / 'staging' / 'prod' to isolate environments.
CLOUDINARY_UPLOAD_FOLDER=local
# Hard cap (Cloudinary rejects oversized uploads at the edge).
CLOUDINARY_MAX_FILE_SIZE_BYTES=31457280
CLOUDINARY_ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,webp,avif
# Upload signature validity window (seconds). Short = lower replay surface.
CLOUDINARY_SIGNATURE_TTL_SECONDS=600

# --- Resend (Cycle 2) ---
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=orders@oorvashee.local

# --- Bot webhook (optional, Cycle 6+) ---
BOT_WEBHOOK_TOKEN=
WHATSAPP_APP_SECRET=
INSTAGRAM_APP_SECRET=

# --- Observability ---
# Empty disables Sentry. WARNING: do NOT put an inline `# comment` after
# the `=` on any of these lines — pydantic-settings does not strip comments
# and a value like `SENTRY_DSN=# disabled` becomes a literal garbage string
# that fails BadDsn at startup. Put comments on their own line, above.
SENTRY_DSN=
# 10% perf traces (0.0–1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1
# Profiling off until measured demand justifies it
SENTRY_PROFILES_SAMPLE_RATE=0.0

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
# Empty = process-local memory. Use redis://host:6379/0 when running >1 replica.
RATE_LIMIT_STORAGE_URI=
RATE_LIMIT_DEFAULT=200/minute

# --- Request hardening ---
# 1 MB JSON cap. Webhook routes bypass this — see BODY_SIZE_EXEMPT_PATH_PREFIXES.
MAX_REQUEST_BODY_BYTES=1048576
BODY_SIZE_EXEMPT_PATH_PREFIXES=/api/v1/webhooks,/api/v1/admin/imports
